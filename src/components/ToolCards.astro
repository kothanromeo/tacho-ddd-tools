---
import { href } from '../site';
interface Props {
  exclude?: string;
}
const { exclude } = Astro.props;
const tools = [
  { path: '/', title: 'Lire un fichier DDD', text: 'Les activités de la carte conducteur jour par jour, les véhicules, les lieux et les infractions probables.' },
  { path: '/calcul-temps-de-conduite/', title: 'Temps de conduite restant', text: 'Combien de temps pouvez-vous encore conduire avant la pause, aujourd’hui et cette semaine ?' },
  { path: '/guides/temps-de-conduite-repos-reglementation/', title: 'Les règles en clair', text: '9 h, 4 h 30, 11 h, 45 h, 56 h, 90 h : les temps de conduite et de repos expliqués avec des exemples.' },
].filter((t) => t.path !== exclude);
---
<div class="grid-3 grid-tools">
  {tools.map((t) => (
    <a class="card tool-card" href={href(t.path)}>
      <h3>{t.title}</h3>
      <p>{t.text}</p>
    </a>
  ))}
</div>
<style>
  .grid-tools { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
</style>
